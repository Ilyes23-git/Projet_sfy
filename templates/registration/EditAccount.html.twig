{% extends 'base.html.twig' %}

{% block title %}Edit Account{% endblock %}

{% block body %}
    <style>
        .edit-account-wrapper {
            min-height: 70vh; /* Centrer verticalement comme le formulaire d'inscription */
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .edit-account-form {
            width: 100%;
            max-width: 450px;
            padding: 30px;
            border: 1px solid #ddd;
            border-radius: 8px;
            background-color: #fff;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        .edit-account-form .form-control {
            padding: 10px;
            font-size: 14px;
            margin-bottom: 15px;
        }
        .edit-account-form button {
            background-color: #007bff;
            color: white;
            width: 100%;
            padding: 10px;
            font-size: 16px;
            border: none;
            border-radius: 4px;
        }
    </style>

    <div class="edit-account-wrapper">
        <div class="edit-account-form">
            <h2>Edit Your Account</h2>

            {% for message in app.flashes('success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}

            {{ form_start(form) }}

            <div class="form-group">
                {{ form_widget(form.nom, {
                    attr: { class: 'form-control', placeholder: 'First Name' }
                }) }}
                {{ form_errors(form.nom) }}
            </div>

            <div class="form-group">
                {{ form_widget(form.prenom, {
                    attr: { class: 'form-control', placeholder: 'Last Name' }
                }) }}
                {{ form_errors(form.prenom) }}
            </div>

            <div class="form-group">
                {{ form_widget(form.email, {
                    attr: { class: 'form-control', placeholder: 'Email' }
                }) }}
                {{ form_errors(form.email) }}
            </div>

            <div class="form-group">
                {{ form_widget(form.telephone, {
                    attr: { class: 'form-control', placeholder: 'Phone number' }
                }) }}
                {{ form_errors(form.telephone) }}
            </div>

            <div class="form-group">
                {{ form_widget(form.adresse, {
                    attr: { class: 'form-control', placeholder: 'adresse' }
                }) }}
                {{ form_errors(form.adresse) }}
            </div>

            <button>Update</button>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
