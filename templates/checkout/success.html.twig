{% extends 'base.html.twig' %}

{% block body %}
<div style="
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-left: 500px;
">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="success-card text-center p-5"
                     style="
                        background: #f8f9fa;
                        border-radius: 10px;
                        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
                     ">
                    
                    <div class="success-icon mb-4">
                        <i class="fa fa-check-circle"
                           style="font-size: 80px; color: #28a745;"></i>
                    </div>

                    <h2 class="mb-3">Order Placed Successfully!</h2>

                    {% if commande is defined %}
                    <div class="order-details mt-4 text-left"
                         style="background: white; padding: 20px; border-radius: 8px;">
                        <h4 class="mb-3">Order Details</h4>
                        <p><strong>Order ID:</strong> #{{ commande.id }}</p>
                        <p><strong>Order Date:</strong> {{ commande.dateCommande|date('d/m/Y H:i') }}</p>
                        <p><strong>Shipping Address:</strong> {{ commande.adresse }}</p>
                        <p><strong>Subtotal:</strong>
                            {{ (commande.prixTotal - commande.fraisLivraison)|number_format(2, '.', ',') }} TND
                        </p>
                        <p>
                            <strong>Total Amount:</strong>
                            <span style="font-size: 1.2em; color: #D10024;">
                                {{ commande.prixTotal|number_format(2, '.', ',') }} TND
                            </span>
                        </p>

                        <h5 class="mt-4 mb-3">Ordered Products:</h5>
                        <ul class="list-group">
                            {% for produit in commande.produits %}
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    {{ produit.nom }}
                                    <span class="badge badge-primary badge-pill">1x</span>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                    {% endif %}

                    <p class="lead mt-4">
                        Thank you for your purchase. Your order is being processed.
                    </p>
                    <p class="text-muted mb-4">
                        You will receive a confirmation email shortly.
                    </p>

                    <a href="{{ path('produit_affichage') }}" class="btn btn-primary">
                        <i class="fa fa-shopping-bag"></i> Continue Shopping
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
