{% extends 'base.html.twig' %}

{% block title %}Shopping Cart{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Shopping Cart</h1>
    
    {% if cartItems|length > 0 %}
        <form action="{{ path('cart_update') }}" method="POST">
            <div class="row">
                <div class="col-12">
                    <table class="table table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Total</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in cartItems %}
                            <tr>
                                <td>{{ item.produit.nom }}</td>
                                <td>{{ item.produit.prix|number_format(2, '.', ',') }} TND</td>
                                <td>
                                    <input type="number" 
                                           name="quantity_{{ item.produit.id }}" 
                                           value="{{ item.quantity }}" 
                                           min="1" 
                                           class="form-control" 
                                           style="width: 80px;">
                                </td>
                                <td>{{ item.total|number_format(2, '.', ',') }} TND</td>
                                <td>
                                    <a href="{{ path('cart_remove', {'id': item.produit.id}) }}" class="btn btn-sm btn-danger">
                                        Remove
                                    </a>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                        <tfoot>
                            <tr class="table-active">
                                <td colspan="3" class="text-end"><strong>Total:</strong></td>
                                <td colspan="2"><strong>{{ total|number_format(2, '.', ',') }} TND</strong></td>
                            </tr>
                        </tfoot>
                    </table>
                    
                    <div class="d-flex justify-content-between mt-4">
                        <a href="{{ path('produit_affichage') }}" class="btn btn-secondary">
                            Continue Shopping
                        </a>
                        <div>
                            <button type="submit" class="btn btn-primary me-2">
                                Update Cart
                            </button>
                            <a href="{{ path('cart_clear') }}" class="btn btn-warning me-2">
                                Clear Cart
                            </a>
                                <a href="{{ path('checkout_index') }}" class="btn btn-success">
                                Checkout
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    {% else %}
        <div class="alert alert-info text-center py-5">
            <h4>Your cart is empty</h4>
            <p class="mt-3">
                <a href="{{ path('produit_affichage') }}" class="btn btn-primary">
                    Continue Shopping
                </a>
            </p>
        </div>
    {% endif %}
</div>
{% endblock %}